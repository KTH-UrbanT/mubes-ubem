    Block Build1_Alt0 Storey 0 IDEAL LOADS AIR SYSTEM,    !- OutputVariable or OutputMeter Index Key Name
    Zone Ideal Loads Supply Air Total Heating Rate;    !- OutputVariable or OutputMeter Name

ENERGYMANAGEMENTSYSTEM:SENSOR,
    Pow2,                     !- Name
    Block Build2_Alt0 Storey 0 IDEAL LOADS AIR SYSTEM,    !- OutputVariable or OutputMeter Index Key Name
    Zone Ideal Loads Supply Air Total Heating Rate;    !- OutputVariable or OutputMeter Name

ENERGYMANAGEMENTSYSTEM:SENSOR,
    DHWPow,                   !- Name
    DHW,                      !- OutputVariable or OutputMeter Index Key Name
    Water Use Equipment Heating Rate;    !- OutputVariable or OutputMeter Name

ENERGYMANAGEMENTSYSTEM:PROGRAMCALLINGMANAGER,
    Average Building Temperature,    !- Name
    EndOfZoneTimestepBeforeZoneReporting,    !- EnergyPlus Model Calling Point
    AverageZoneTemps;         !- Program Name 1

ENERGYMANAGEMENTSYSTEM:PROGRAMCALLINGMANAGER,
    Compute Total Building Heat Pow,    !- Name
    EndOfZoneTimestepBeforeZoneReporting,    !- EnergyPlus Model Calling Point
    TotZonePow;               !- Program Name 1

ENERGYMANAGEMENTSYSTEM:PROGRAMCALLINGMANAGER,
    Compute Total DHW Heat Pow,    !- Name
    EndOfZoneTimestepBeforeZoneReporting,    !- EnergyPlus Model Calling Point
    prgmDHWPow;               !- Program Name 1

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    AverageZoneTemps,         !- Name
    SET SumNumerator = T0*Vol0+T1*Vol1+T2*Vol2,    !- Program Line 1
    SET SumDenominator  = Vol0+Vol1+Vol2,    !- Program Line 2
    SET AverageBuildingTemp  = SumNumerator / SumDenominator;    !- Program Line 3

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    TotZonePow,               !- Name
    SET TotBuildPow = Pow0+Pow1+Pow2;    !- Program Line 1

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    prgmDHWPow,               !- Name
    SET TotDHWPow = DHWPow;    !- Program Line 1

ENERGYMANAGEMENTSYSTEM:GLOBALVARIABLE,
    AverageBuildingTemp;      !- Erl Variable 1 Name

ENERGYMANAGEMENTSYSTEM:GLOBALVARIABLE,
    TotBuildPow;              !- Erl Variable 1 Name

ENERGYMANAGEMENTSYSTEM:GLOBALVARIABLE,
    TotDHWPow;                !- Erl Variable 1 Name

ENERGYMANAGEMENTSYSTEM:OUTPUTVARIABLE,
    Mean Heated Zones Air Temperature,    !- Name
    AverageBuildingTemp,      !- EMS Variable Name
    Averaged,                 !- Type of Data in Variable
    ZoneTimeStep;             !- Update Frequency

ENERGYMANAGEMENTSYSTEM:OUTPUTVARIABLE,
    Total Building Heating Power,    !- Name
    TotBuildPow,              !- EMS Variable Name
    Averaged,                 !- Type of Data in Variable
    ZoneTimeStep;             !- Update Frequency

ENERGYMANAGEMENTSYSTEM:OUTPUTVARIABLE,
    Total DHW Heating Power,    !- Name
    TotDHWPow,                !- EMS Variable Name
    Averaged,                 !- Type of Data in Variable
    ZoneTimeStep;             !- Update Frequency

ENERGYMANAGEMENTSYSTEM:INTERNALVARIABLE,
    Vol0,                     !- Name
    Block Build0_Alt0 Storey 0,    !- Internal Data Index Key Name
    Zone Air Volume;          !- Internal Data Type

ENERGYMANAGEMENTSYSTEM:INTERNALVARIABLE,
    Vol1,                     !- Name
    Block Build1_Alt0 Storey 0,    !- Internal Data Index Key Name
    Zone Air Volume;          !- Internal Data Type

ENERGYMANAGEMENTSYSTEM:INTERNALVARIABLE,
    Vol2,                     !- Name
    Block Build2_Alt0 Storey 0,    !- Internal Data Index Key Name
    Zone Air Volume;          !- Internal Data Type

WATERUSE:EQUIPMENT,
    DHW,                      !- Name
    General,                  !- EndUse Subcategory
    1.594080e-08,             !- Peak Flow Rate
    WaterTaps,                !- Flow Rate Fraction Schedule Name
    TargetWaterTemp,          !- Target Temperature Schedule Name
    HotWaterTemp,             !- Hot Water Supply Temperature Schedule Name
    ColdWaterTemp;            !- Cold Water Supply Temperature Schedule Name

Output:VariableDictionary,
    Regular;                  !- Key Field

OUTPUT:ENERGYMANAGEMENTSYSTEM,
    Verbose,                  !- Actuator Availability Dictionary Reporting
