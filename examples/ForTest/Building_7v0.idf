    T0,                       !- Name
    Block Build0_Alt0 Storey 0,    !- OutputVariable or OutputMeter Index Key Name
    Zone Mean Air Temperature;    !- OutputVariable or OutputMeter Name

ENERGYMANAGEMENTSYSTEM:SENSOR,
    Pow0,                     !- Name
    Block Build0_Alt0 Storey 0 IDEAL LOADS AIR SYSTEM,    !- OutputVariable or OutputMeter Index Key Name
    Zone Ideal Loads Supply Air Total Heating Rate;    !- OutputVariable or OutputMeter Name

ENERGYMANAGEMENTSYSTEM:SENSOR,
