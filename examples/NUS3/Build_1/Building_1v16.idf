ENERGYMANAGEMENTSYSTEM:PROGRAM,
    TotZonePow,               !- Name
    SET TotBuildPow = Pow0+Pow1+Pow2+Pow3+Pow4+Pow5+Pow6+Pow7+Pow8;    !- Program Line 1

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    prgmDHWPow,               !- Name
    SET TotDHWPow = DHWPow;    !- Program Line 1

