    EndOfZoneTimestepBeforeZoneReporting,    !- EnergyPlus Model Calling Point
    prgmDHWPow;               !- Program Name 1

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    AverageZoneTemps,         !- Name
    SET SumNumerator = T0*Vol0+T1*Vol1+T2*Vol2+T3*Vol3+T4*Vol4+T5*Vol5+T6*Vol6+T7*Vol7+T8*Vol8,    !- Program Line 1
    SET SumDenominator  = Vol0+Vol1+Vol2+Vol3+Vol4+Vol5+Vol6+Vol7+Vol8,    !- Program Line 2
    SET AverageBuildingTemp  = SumNumerator / SumDenominator;    !- Program Line 3

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    AverageZoneTemps_0,       !- Name
    IF T0 < 21,               !- Program Line 1
      SET Zone_Block_Build_0_Alt0_Storey_0_Override = 25,    !- Program Line 2
    ELSE,                     !- Program Line 3
      SET Zone_BLOCK_BUILD_0_ALTO_STOREY_0_Override = 15,    !- Program Line 4
    ENDIF;                    !- Program Line 5

