ENERGYMANAGEMENTSYSTEM:PROGRAMCALLINGMANAGER,
    Average Building Temperature,    !- Name
    EndOfZoneTimestepBeforeZoneReporting,    !- EnergyPlus Model Calling Point
    AverageZoneTemps;         !- Program Name 1

ENERGYMANAGEMENTSYSTEM:PROGRAMCALLINGMANAGER,
    Compute Total Building Heat Pow,    !- Name
    EndOfZoneTimestepBeforeZoneReporting,    !- EnergyPlus Model Calling Point
    TotZonePow;               !- Program Name 1

ENERGYMANAGEMENTSYSTEM:PROGRAMCALLINGMANAGER,
    Compute Total DHW Heat Pow,    !- Name
    EndOfZoneTimestepBeforeZoneReporting,    !- EnergyPlus Model Calling Point
    prgmDHWPow;               !- Program Name 1

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    AverageZoneTemps,         !- Name
    SET SumNumerator = T0*Vol0+T1*Vol1+T2*Vol2+T3*Vol3+T4*Vol4+T5*Vol5+T6*Vol6+T7*Vol7+T8*Vol8+T9*Vol9+T10*Vol10+T11*Vol11+T12*Vol12+T13*Vol13+T14*Vol14+T15*Vol15,    !- Program Line 1
    SET SumDenominator  = Vol0+Vol1+Vol2+Vol3+Vol4+Vol5+Vol6+Vol7+Vol8+Vol9+Vol10+Vol11+Vol12+Vol13+Vol14+Vol15,    !- Program Line 2
    SET AverageBuildingTemp  = SumNumerator / SumDenominator;    !- Program Line 3

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    TotZonePow,               !- Name
    SET TotBuildPow = Pow0+Pow1+Pow2+Pow3+Pow4+Pow5+Pow6+Pow7+Pow8+Pow9+Pow10+Pow11+Pow12+Pow13+Pow14+Pow15;    !- Program Line 1

ENERGYMANAGEMENTSYSTEM:PROGRAM,
    prgmDHWPow,               !- Name
    SET TotDHWPow = DHWPow;    !- Program Line 1

ENERGYMANAGEMENTSYSTEM:GLOBALVARIABLE,
    AverageBuildingTemp;      !- Erl Variable 1 Name

ENERGYMANAGEMENTSYSTEM:GLOBALVARIABLE,
    TotBuildPow;              !- Erl Variable 1 Name

ENERGYMANAGEMENTSYSTEM:GLOBALVARIABLE,
    TotDHWPow;                !- Erl Variable 1 Name

ENERGYMANAGEMENTSYSTEM:OUTPUTVARIABLE,
    Mean Heated Zones Air Temperature,    !- Name
    AverageBuildingTemp,      !- EMS Variable Name
    Averaged,                 !- Type of Data in Variable
    ZoneTimeStep;             !- Update Frequency

ENERGYMANAGEMENTSYSTEM:OUTPUTVARIABLE,
    Total Building Heating Power,    !- Name
    TotBuildPow,              !- EMS Variable Name
    Averaged,                 !- Type of Data in Variable
    ZoneTimeStep;             !- Update Frequency

ENERGYMANAGEMENTSYSTEM:OUTPUTVARIABLE,
    Total DHW Heating Power,    !- Name
    TotDHWPow,                !- EMS Variable Name
    Averaged,                 !- Type of Data in Variable
    ZoneTimeStep;             !- Update Frequency

